<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduCam.ViewModels"
             x:Class="EduCam.Views.HomePage"
             Title="EduCam"
             BackgroundColor="#F7FAFC">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Enseignant" Command="{Binding OpenTeacherCommand}" />
        <ToolbarItem Text="Historique" Command="{Binding OpenHistoryCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header -->
                <Frame BackgroundColor="#2B6CB0" CornerRadius="16" Padding="20" HasShadow="True">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="EduCam" FontSize="28" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Quiz scolaire hors ligne" FontSize="15" TextColor="#E2E8F0" />
                        <Label Text="Révise sans Internet • Maths • Français • Histoire" 
                               FontSize="13" TextColor="#CBD5E0" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Choisis un questionnaire" FontSize="18" FontAttributes="Bold" TextColor="#2D3748" />

                <CollectionView ItemsSource="{Binding Quizzes}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,0,12" Padding="16" CornerRadius="12" 
                                   BackgroundColor="White" HasShadow="True"
                                   BorderColor="#E2E8F0">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenQuizCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" 
                                           FontSize="17" FontAttributes="Bold" TextColor="#2D3748" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Subject}" 
                                           FontSize="12" TextColor="White" BackgroundColor="#2B6CB0"
                                           Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                           FontSize="13" TextColor="#718096" Margin="0,4,0,0" />
                                    <Label Grid.Row="2" Grid.ColumnSpan="2" 
                                           Text="{Binding Questions.Count, StringFormat='{0} questions'}" 
                                           FontSize="12" TextColor="#A0AEC0" Margin="0,6,0,0" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="💡 Astuce : les enseignants peuvent créer leurs propres quiz dans l'espace Enseignant."
                       FontSize="12" TextColor="#718096" HorizontalTextAlignment="Center" Margin="0,10,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
