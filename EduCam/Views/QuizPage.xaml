<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EduCam.Views.QuizPage"
             Title="{Binding Title}"
             BackgroundColor="#F7FAFC">

    <Grid>
        <!-- QUIZ EN COURS -->
        <ScrollView IsVisible="{Binding IsFinished, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Progress -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ProgressText}" FontSize="14" TextColor="#4A5568" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="#2B6CB0" HeightRequest="8" />
                </VerticalStackLayout>

                <!-- Question -->
                <Frame BackgroundColor="White" CornerRadius="14" Padding="20" HasShadow="True" BorderColor="#E2E8F0">
                    <Label Text="{Binding CurrentQuestion.Text}" FontSize="18" FontAttributes="Bold" 
                           TextColor="#1A202C" LineBreakMode="WordWrap" />
                </Frame>

                <!-- Options -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentQuestion.Options}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectOptionCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#EDF2F7"
                                    TextColor="#2D3748"
                                    FontSize="15"
                                    CornerRadius="10"
                                    HeightRequest="52"
                                    BorderWidth="1"
                                    BorderColor="#E2E8F0" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Selected feedback -->
                <Label Text="{Binding SelectedOption, StringFormat='Réponse choisie : {0}'}" 
                       IsVisible="{Binding HasAnswered}"
                       FontSize="14" TextColor="#2B6CB0" HorizontalTextAlignment="Center" />

                <!-- Next / Finish button -->
                <Button Text="{Binding IsLastQuestion, Converter={StaticResource BoolToFinishTextConverter}}"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding HasAnswered}"
                        BackgroundColor="#2B6CB0"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- RÉSULTAT FINAL -->
        <ScrollView IsVisible="{Binding IsFinished}">
            <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

                <Frame BackgroundColor="#2B6CB0" CornerRadius="20" Padding="28" HasShadow="True">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Résultat" FontSize="16" TextColor="#E2E8F0" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Score, StringFormat='{0}'}" FontSize="48" FontAttributes="Bold" 
                               TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Quiz.Questions.Count, StringFormat='sur {0} questions'}" 
                               FontSize="16" TextColor="#CBD5E0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="{Binding FinalMessage}" FontSize="18" FontAttributes="Bold" 
                       TextColor="#2D3748" HorizontalTextAlignment="Center" />

                <Button Text="Recommencer" Command="{Binding RestartCommand}"
                        BackgroundColor="#48BB78" TextColor="White" CornerRadius="12" HeightRequest="48" />

                <Button Text="Retour à l'accueil" Command="{Binding GoHomeCommand}"
                        BackgroundColor="#EDF2F7" TextColor="#2D3748" CornerRadius="12" HeightRequest="48" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
